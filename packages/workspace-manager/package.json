{
  "name": "@fleetwide/workspace-manager",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "dev": "tsc --project tsconfig.build.json --watch",
    "test": "vitest run",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist *.tsbuildinfo",
    "test:integration": "tsx scripts/integration-test.ts"
  },
  "dependencies": {
    "@fleetwide/core": "workspace:*",
    "@fleetwide/database": "workspace:*",
    "dockerode": "^4.0.4",
    "drizzle-orm": "^0.38.0"
  },
  "devDependencies": {
    "@types/dockerode": "^3.3.35",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
